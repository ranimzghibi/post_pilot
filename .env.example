# PostPilot : variables d'environnement
# Copier ce fichier en .env.local puis renseigner au minimum la section Supabase.
# Tout ce qui reste vide bascule sur un mode démo signalé dans l'interface.

# --- Application -------------------------------------------------------------
# URL publique du site, sans barre finale (utilisée dans les e-mails et OAuth).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Supabase (obligatoire) ----------------------------------------------------
# Dashboard > Project Settings > Data API / API Keys
NEXT_PUBLIC_SUPABASE_URL=
# Clé publique : « anon » ou « publishable » (sb_publishable_...).
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Clé secrète : « service_role » ou « secret » (sb_secret_...). Jamais côté navigateur.
SUPABASE_SERVICE_ROLE_KEY=

# --- Connexion Google (facultatif) ---------------------------------------------
# À activer dans Dashboard > Authentication > Providers > Google, puis mettre true.
NEXT_PUBLIC_AUTH_GOOGLE_ENABLED=false

# --- IA : texte (facultatif, mode démo si vide) --------------------------------
# anthropic | openai-compatible | demo. Vide : détection selon les clés présentes.
AI_PROVIDER=
ANTHROPIC_API_KEY=
# Stratégie, calendrier, publications (tableau 2.11 du rapport).
AI_TEXT_MODEL=claude-sonnet-5-5
# Contrôle de conformité, hashtags.
AI_FAST_MODEL=claude-haiku-4-5
# Serveur compatible OpenAI, open source ou non (Ollama, LocalAI, vLLM...).
# Exemple Ollama : AI_BASE_URL=http://localhost:11434/v1  AI_TEXT_MODEL=qwen3
AI_BASE_URL=
AI_API_KEY=

# --- IA : vecteurs de la base de connaissances (facultatif) --------------------
# Serveur compatible OpenAI. Sans lui, un index lexical local est utilisé.
# La base attend des vecteurs de dimension 1024 (bge-m3 par exemple).
EMBEDDING_BASE_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=bge-m3

# --- IA : images (facultatif) --------------------------------------------------
# Serveur compatible OpenAI (/images/generations). Sans lui, images de démonstration.
IMAGE_BASE_URL=
IMAGE_API_KEY=
IMAGE_MODEL=

# --- Meta : Facebook et Instagram (facultatif, bac à sable si vide) ------------
META_APP_ID=
META_APP_SECRET=
META_GRAPH_VERSION=v24.0

# --- E-mails d'invitation (facultatif) -----------------------------------------
# Sans clé, le lien d'invitation est affiché pour être copié.
RESEND_API_KEY=
EMAIL_FROM=PostPilot <no-reply@example.com>
